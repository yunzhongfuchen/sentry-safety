# Sentry RK3588 边缘端部署配置

# ==================== VLM 配置 ====================
# 自动判断：如果 BAILIAN_API_KEY 有值则使用百炼，否则使用 Ark
# 切换方式：注释/取消注释对应行的 API Key 即可

# --- 火山引擎 Ark ---
ARK_API_KEY=6314aff2-59e9-4725-aae9-11c79324167a
VLM_ENDPOINT=ep-20260331120429-b984d

# --- 阿里云百炼 ---
# BAILIAN_API_KEY=sk-xxxxxxxx
# BAILIAN_MODEL=qwen3.5-plus

# ==================== 检测器配置 ====================
# 检测设备: npu (RK3588 NPU) | cpu | cuda
DETECTION_DEVICE=npu

# YOLO 模型 (CPU模式使用)
YOLO_MODEL=yolov8n.pt

# RKNN 模型路径 (NPU模式使用)
RKNN_MODEL=models/yolov8n.rknn

# 检测置信度
DETECTION_CONFIDENCE=0.5

# ==================== 摄像头配置 ====================
# 方式1: 使用 CAMERAS 环境变量 (格式: id:source:id2:source2)
# 示例: CAMERAS=cam_01:0:cam_02:rtsp://192.168.1.100/stream
# CAMERAS=cam_01:0

# 方式2: 使用配置文件 (config/cameras.json)
# 如果 CAMERAS 为空，则自动加载 cameras.json

# 默认视频源 (单摄像头模式回退)
VIDEO_SOURCE=0

# ==================== 抽帧配置 ====================
FRAME_COUNT=15
FRAME_INTERVAL=0.5
TRIGGER_COOLDOWN=3

# ==================== 服务配置 ====================
API_HOST=0.0.0.0
API_PORT=8000

# ==================== RK3588 特定配置 ====================
# NPU 核心分配策略: auto | manual
RKNN_CORE_MODE=auto

# 是否启用零拷贝推理 (减少内存拷贝开销)
RKNN_ZERO_COPY=true

# 日志级别
LOG_LEVEL=WARNING
