	cd /workspace/sophon-stream-master/build && $(MAKE) -f element/algorithm/ppocr/CMakeFiles/ppocr_rec.dir/build.make element/algorithm/ppocr/CMakeFiles/ppocr_rec.dir/src/ppocr_rec/ppocr_rec_pre_process.cc.i
.PHONY : src/ppocr_rec/ppocr_rec_pre_process.cc.i

src/ppocr_rec/ppocr_rec_pre_process.s: src/ppocr_rec/ppocr_rec_pre_process.cc.s

.PHONY : src/ppocr_rec/ppocr_rec_pre_process.s

# target to generate assembly for a file
